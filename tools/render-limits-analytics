#!/usr/bin/env python3
"""Owner-only PNG usage charts via OpenClaw sessions.usage. No LLM calls.

Usage: render-limits-analytics GROUPS_PNG TOPICS_PNG [--timezone ZONE] [--fixture JSON]
Only aggregate charts are written; provider credentials and raw session data are not saved.
"""
import argparse
import json
import math
import os
import re
import shutil
import subprocess
import sys
from collections import defaultdict
from datetime import datetime
from pathlib import Path
from zoneinfo import ZoneInfo

from PIL import Image, ImageDraw, ImageFont

def resolve_zone(explicit=None):
    # An IANA zone is needed by sessions.usage, including historical DST.
    candidates = [explicit, os.getenv('OPENCLAW_USAGE_TIMEZONE'), os.getenv('TZ')]
    try:
        candidates.append(Path('/etc/timezone').read_text().strip())
    except OSError:
        pass
    try:
        local = str(Path('/etc/localtime').resolve())
        marker = '/zoneinfo/'
        if marker in local:
            candidates.append(local.split(marker, 1)[1])
    except OSError:
        pass
    for name in candidates + ['UTC']:
        if not name:
            continue
        try:
            return ZoneInfo(name)
        except (KeyError, ValueError):
            continue
    return ZoneInfo('UTC')

TZ = resolve_zone()
BG, INK, MUTED, ACCENT, ALT, GRID = '#f2f8f7', '#163047', '#61778b', '#159b72', '#4194c5', '#e4ecef'
WIDTH = 1200
FONTS = [
    ('/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf', '/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf'),
    ('/usr/share/fonts/truetype/noto/NotoSans-Regular.ttf', '/usr/share/fonts/truetype/noto/NotoSans-Bold.ttf'),
]

def font(size, bold=False):
    for normal, strong in FONTS:
        path = strong if bold else normal
        if Path(path).is_file():
            return ImageFont.truetype(path, size)
    raise RuntimeError('TrueType font missing: install fonts-dejavu-core')

def request_usage(start, end):
    params = dict(startDate=start, endDate=end, mode='specific', timeZone=TZ.key,
                  agentScope='all', groupBy='family', limit=1000)
    home = Path.home()
    cli = os.getenv('OPENCLAW_BIN') or shutil.which('openclaw')
    if not cli:
        cli = next((str(candidate) for candidate in [home / '.npm-global/bin/openclaw', home / '.local/bin/openclaw'] if candidate.is_file()), 'openclaw')
    command = [cli, 'gateway', 'call', 'sessions.usage', '--params',
               json.dumps(params), '--json']
    result = subprocess.run(command, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=40, check=True)
    report = json.loads(result.stdout)
    if not isinstance(report, dict) or report.get('ok') is False or not isinstance(report.get('sessions'), list):
        raise RuntimeError('sessions.usage returned an unsupported response')
    return report

def tokens(value):
    if not isinstance(value, dict):
        return None
    number = value.get('totalTokens')
    if isinstance(number, (int, float)) and not isinstance(number, bool) and math.isfinite(number) and number >= 0:
        return int(number)
    return None

def group_topic(session):
    key = session.get('key', '')
    label = session.get('label', '') or ''
    origin = session.get('origin') or {}
    marker = origin.get('nativeChannelId') or key
    match = re.search(r'(-100\d+):topic:(\d+)', str(marker))
    if not match:
        return None
    group_id, topic_id = match.groups()
    parts = label.split(' / ', 1)
    group_name = parts[0].strip() if len(parts) > 1 else f'Group {group_id}'
    topic_name = parts[1].strip() if len(parts) > 1 else f'Topic {topic_id}'
    return group_id, topic_id, group_name[:70], topic_name[:70]

def summarise(report):
    groups, topics = defaultdict(int), defaultdict(int)
    group_names, topic_names = {}, {}
    missing = 0
    for session in report.get('sessions', []):
        parsed = group_topic(session)
        if not parsed:
            continue
        group_id, topic_id, group_name, topic_name = parsed
        count = tokens(session.get('usage'))
        if count is None:
            missing += 1
            continue
        groups[group_id] += count
        topics[(group_id, topic_id)] += count
        group_names[group_id] = group_name
        topic_names[(group_id, topic_id)] = f'{group_name} / {topic_name}'
    cache = report.get('cacheStatus') or {}
    status = cache.get('status', 'unknown')
    pending = cache.get('pendingFiles', 0)
    counted = (report.get('aggregates') or {}).get('sessionCount', len(report.get('sessions', [])))
    truncated = counted > len(report.get('sessions', []))
    complete = status == 'fresh' and pending == 0 and missing == 0 and not truncated and tokens(report.get('totals')) is not None
    return dict(groups=groups, topics=topics, group_names=group_names, topic_names=topic_names,
                missing=missing, pending=pending, status=status, complete=complete,
                truncated=truncated, total=tokens(report.get('totals')),
                daily=(report.get('aggregates') or {}).get('daily', []))

def shortened(draw, value, size, width):
    current = str(value)
    full = current
    while current and draw.textbbox((0, 0), current, font=font(size))[2] > width:
        current = current[:-1]
    return current + '…' if current != full else current

def human(number):
    if number is None:
        return 'no data'
    if number >= 1_000_000:
        return f'{number / 1_000_000:.2f}M'
    if number >= 1000:
        return f'{number / 1000:.1f}k'
    return str(number)

def render(output, title, key, today, lifetime, trend=False):
    height = 1850 if trend else 1490
    img = Image.new('RGB', (WIDTH, height), BG)
    draw = ImageDraw.Draw(img)
    draw.rounded_rectangle((30, 30, WIDTH - 30, height - 30), 36, fill='white')
    draw.text((70, 65), title, font=font(42, True), fill=INK)
    draw.text((72, 126), f'OpenClaw · {TZ.key} · retained session history', font=font(22), fill=MUTED)
    draw.text((72, 158), 'Totals include all sessions; bars show Telegram forum groups/topics only.', font=font(16), fill=MUTED)
    for label, summary, top in [('TODAY', today, 215), ('RETAINED HISTORY (SINCE 2020)', lifetime, 798)]:
        draw.rounded_rectangle((65, top - 9, WIDTH - 65, top + 60), 16, fill='#edf6f4')
        draw.text((86, top + 1), label, font=font(28, True), fill=INK)
        value = human(summary['total']) if summary['complete'] else (
            f'~ {human(summary["total"])}' if summary['total'] is not None else 'unavailable')
        draw.text((WIDTH - 100, top + 5), value + (' tokens' if summary['complete'] and summary['total'] is not None else ''),
                  anchor='ra', font=font(23, True), fill=ACCENT)
        if not summary['complete']:
            warning = f'PARTIAL DATA · cache: {summary["status"]} · pending: {summary["pending"]} · missing usage: {summary["missing"]}'
            if summary['truncated']:
                warning += ' · result capped'
            draw.text((86, top + 66), shortened(draw, warning, 18, 1045), font=font(18), fill='#ad6f25')
        ranked = sorted(summary[key].items(), key=lambda item: (-item[1], str(item[0])))[:9]
        names = summary['group_names'] if key == 'groups' else summary['topic_names']
        if not ranked:
            draw.text((86, top + 174), 'No ranked sessions available.', font=font(22), fill=MUTED)
            continue
        maximum = max(value for _, value in ranked) or 1
        y = top + 116
        for identity, value in ranked:
            draw.text((85, y), shortened(draw, names.get(identity, str(identity)), 21, 620),
                      font=font(21), fill=INK)
            draw.rounded_rectangle((718, y + 3, 1029, y + 20), 8, fill=GRID)
            width = max(2, round(311 * value / maximum))
            draw.rounded_rectangle((718, y + 3, 718 + width, y + 20), 8,
                                   fill=ACCENT if key == 'groups' else ALT)
            draw.text((1093, y - 2), human(value), font=font(20, True), fill=INK, anchor='ra')
            y += 47
    if trend:
        draw.text((82, 1393), 'TREND · last 14 days (all sessions)', font=font(26, True), fill=INK)
        days = {}
        for row in lifetime['daily']:
            if not isinstance(row, dict):
                continue
            value = row.get('tokens')
            day = str(row.get('date', ''))
            if re.fullmatch(r'\d{4}-\d{2}-\d{2}', day) and isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value) and value >= 0:
                days[day] = value
        recent = sorted(days.items())[-14:]
        if recent:
            maximum = max([value for _, value in recent] + [1])
            for i, (day, value) in enumerate(recent):
                x, baseline = 88 + i * 73, 1700
                height_bar = int(195 * max(0, value) / maximum)
                if height_bar:
                    draw.rounded_rectangle((x, baseline - height_bar, x + 43, baseline), 6, fill=ACCENT)
                draw.text((x + 20, baseline + 9), day[-2:], font=font(16), fill=MUTED, anchor='ma')
        else:
            draw.text((88, 1501), 'Daily totals unavailable.', font=font(21), fill=MUTED)
    draw.text((85, height - 100), 'Tokens cannot be attributed reliably to individual authors in a shared topic.',
              font=font(18), fill=MUTED)
    draw.text((85, height - 75), 'OAuth quota and session token counts are different metrics.', font=font(18), fill=MUTED)
    target = Path(output)
    target.parent.mkdir(parents=True, exist_ok=True)
    temporary = target.with_name(target.name + '.tmp')
    img.save(temporary, format='PNG', optimize=True)
    os.chmod(temporary, 0o600)
    os.replace(temporary, target)


def main():
    global TZ
    parser = argparse.ArgumentParser(description='Render private aggregate session usage reports.')
    parser.add_argument('groups')
    parser.add_argument('topics')
    parser.add_argument('--timezone')
    parser.add_argument('--fixture', type=Path, help='Synthetic test input; no gateway calls')
    args = parser.parse_args()
    TZ = resolve_zone(args.timezone)
    today_date = datetime.now(TZ).strftime('%Y-%m-%d')
    if args.fixture:
        reports = json.loads(args.fixture.read_text(encoding='utf-8'))
        today, lifetime = reports['today'], reports['all']
    else:
        today = request_usage(today_date, today_date)
        lifetime = request_usage('2020-01-01', today_date)
    day_summary, all_summary = summarise(today), summarise(lifetime)
    render(args.groups, 'Groups & Projects', 'groups', day_summary, all_summary)
    render(args.topics, 'Topics & Trends', 'topics', day_summary, all_summary, trend=True)
    print(json.dumps({'today': {'cache': day_summary['status'], 'pending': day_summary['pending']},
                      'all': {'cache': all_summary['status'], 'pending': all_summary['pending']}}))

if __name__ == '__main__':
    main()
